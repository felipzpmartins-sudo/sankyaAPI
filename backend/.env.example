# Contas criadas na tabela `usuarios` no boot, no formato email:senha,
# separadas por virgula. So cria o que ainda nao existe: depois que a pessoa
# troca a senha, deixar a variavel aqui nao reverte nada.
# A conta nasce com troca de senha obrigatoria no primeiro acesso.
USUARIOS_INICIAIS=

PORT=3000
LOG_LEVEL=info

CORS_ORIGINS=http://localhost:4173,http://localhost:5173

DATABASE_PATH=./data/snapshot.db

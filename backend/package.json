{
  "name": "sankya-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "sync:all": "tsx scripts/sync-all.ts",
    "sync:estoque": "tsx scripts/sync-estoque.ts",
    "sankhya:inventory": "tsx scripts/sankhya-raw-extract.ts --mode=inventory",
    "sankhya:sample": "tsx scripts/sankhya-raw-extract.ts --mode=sample --maxPages=1 --maxRows=100",
    "sankhya:extract": "tsx scripts/sankhya-raw-extract.ts --mode=extract --maxRows=0 --logEveryPages=10",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
